		"@tabler/icons-react": "^3.35.0",
		"class-variance-authority": "^0.7.1",
		"cloudinary": "^2.8.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.5",
		"drizzle-orm": "^0.44.6",
		"lucide-react": "^0.546.0",
		"motion": "^12.23.24",
		"next": "15.4.6",
		"next-cloudinary": "^6.16.2",
		"next-themes": "^0.4.6",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-dropzone": "^14.3.8",
