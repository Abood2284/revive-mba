		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4",
		"tsx": "^4.19.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5",
		"wrangler": "^4.43.0"
